#!/usr/bin/env python3
"""
novel — AI Novel Workstation CLI 工具

Commands:
    novel create <name>                 创建新项目
    novel list [projects|chapters|characters] 列出项目/章节/角色
    novel export <project-id> [--format=json|txt|md] [--output-dir=path]  导出项目
    novel backup <project-id>           备份项目数据
    novel search <project-id> <keyword> 搜索项目内容
"""

import argparse
import json
import os
import sys
from datetime import datetime

try:
    import requests
except ImportError:
    print("错误: 需要安装 requests 库。请运行: pip install requests", file=sys.stderr)
    sys.exit(1)

BASE_API = "http://127.0.0.1:9000/api/v1"

# ── helpers ──────────────────────────────────────────────────────────


def _api_get(path):
    """GET request, return parsed JSON."""
    url = f"{BASE_API}{path}"
    try:
        resp = requests.get(url, timeout=30)
        resp.raise_for_status()
        return resp.json()
    except requests.exceptions.ConnectionError:
        print(f"ERROR: 无法连接到后端 API {BASE_API}", file=sys.stderr)
        print("请确认后端已启动: cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 9000", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.HTTPError as e:
        print(f"API 错误 [{e.response.status_code}]: {e.response.text[:500]}", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.RequestException as e:
        print(f"请求失败: {e}", file=sys.stderr)
        sys.exit(1)


def _api_post(path, data=None):
    """POST request with JSON body, return parsed JSON."""
    url = f"{BASE_API}{path}"
    try:
        resp = requests.post(url, json=data or {}, timeout=30)
        resp.raise_for_status()
        return resp.json()
    except requests.exceptions.ConnectionError:
        print(f"ERROR: 无法连接到后端 API {BASE_API}", file=sys.stderr)
        print("请确认后端已启动: cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 9000", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.HTTPError as e:
        print(f"API 错误 [{e.response.status_code}]: {e.response.text[:500]}", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.RequestException as e:
        print(f"API 失败: {e}", file=sys.stderr)
        sys.exit(1)


def _api_get_raw(path):
    """GET request, return raw Response object (for streaming/attachment)."""
    url = f"{BASE_API}{path}"
    try:
        resp = requests.get(url, timeout=60)
        resp.raise_for_status()
        return resp
    except requests.exceptions.ConnectionError:
        print(f"ERROR: 无法连接到后端 API {BASE_API}", file=sys.stderr)
        print("请确认后端已启动: cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 9000", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.HTTPError as e:
        print(f"API 错误 [{e.response.status_code}]: {e.response.text[:500]}", file=sys.stderr)
        sys.exit(1)
    except requests.exceptions.RequestException as e:
        print(f"API 失败: {e}", file=sys.stderr)
        sys.exit(1)


def _safe_name(name):
    """将项目名转为安全的文件名。"""
    safe = (name or "project").replace(" ", "_")
    for ch in r"\\/:*?\"<>|":
        safe = safe.replace(ch, "_")
    return safe


def _truncate(text, max_len=80):
    """截断过长文本用于表格显示。"""
    if not text:
        return ""
    s = str(text).replace("\n", " ").replace("\r", " ")
    if len(s) > max_len:
        return s[:max_len - 3] + "..."
    return s


# ── subcommand: create ────────────────────────────────────────────────

def cmd_create(args):
    """创建新项目。"""
    data = {
        "name": args.name,
        "description": args.description or "",
        "genre": args.genre or "other",
    }
    result = _api_post("/projects", data)
    print(f"✓ 项目已创建")
    print(f"  ID:   {result['id']}")
    print(f"  名称: {result['name']}")
    print(f"  流派: {result.get('genre', 'N/A')}")
    print(f"  状态: {result.get('status', 'N/A')}")


# ── subcommand: list ──────────────────────────────────────────────────

def cmd_list(args):
    """列出项目 / 章节 / 角色。"""
    if args.type == "projects":
        _cmd_list_projects()
    elif args.type == "chapters":
        if not args.project_id:
            print("ERROR: 列出章节需要 --project-id 参数", file=sys.stderr)
            sys.exit(1)
        _cmd_list_chapters(args.project_id)
    elif args.type == "characters":
        if not args.project_id:
            print("ERROR: 列出角色需要 --project-id 参数", file=sys.stderr)
            sys.exit(1)
        _cmd_list_characters(args.project_id)


def _cmd_list_projects():
    """列出所有项目（表格格式）。"""
    result = _api_get("/projects?size=50")
    items = result.get("items", [])
    total = result.get("total", len(items))

    if not items:
        print("(无项目)")
        return

    # 计算列宽
    id_width = 36
    name_width = max(max(len(_truncate(p.get("name", ""), 30)) for p in items), 4)
    genre_width = max(max(len(p.get("genre", "") or "N/A") for p in items), 8)
    status_width = max(max(len(p.get("status", "") or "N/A") for p in items), 8)

    header = f"{'ID':<{id_width}}  {'名称':<{name_width}}  {'流派':<{genre_width}}  {'状态':<{status_width}}"
    sep = "─" * len(header)
    print(sep)
    print(header)
    print(sep)
    for p in items:
        pid = str(p["id"])
        name = _truncate(p.get("name", ""), name_width)
        genre = p.get("genre") or "N/A"
        status = p.get("status") or "N/A"
        print(f"{pid:<{id_width}}  {name:<{name_width}}  {genre:<{genre_width}}  {status:<{status_width}}")
    print(sep)
    print(f"共 {total} 个项目")


def _cmd_list_chapters(project_id):
    """列出项目所有章节（表格格式）。"""
    result = _api_get(f"/projects/{project_id}/chapters")
    items = result  # chapters returns a list directly

    if not items:
        print("(无章节)")
        return

    num_width = 6
    title_width = max(max(len(_truncate(c.get("title", ""), 40)) for c in items), 10)
    words_width = 8
    status_width = 8

    header = f"{'章节':<{num_width}}  {'标题':<{title_width}}  {'字数':>{words_width}}  {'状态':<{status_width}}"
    sep = "─" * len(header)
    print(sep)
    print(header)
    print(sep)
    for c in items:
        num = str(c.get("chapter_number", "?"))
        title = _truncate(c.get("title", ""), title_width)
        words = str(c.get("word_count", 0))
        status = c.get("status", "draft")
        print(f"{num:<{num_width}}  {title:<{title_width}}  {words:>{words_width}}  {status:<{status_width}}")
    print(sep)
    print(f"共 {len(items)} 个章节")


def _cmd_list_characters(project_id):
    """列出项目所有角色（表格格式）。"""
    result = _api_get(f"/projects/{project_id}/characters")
    items = result  # result 是一个列表

    if not items:
        print("(无角色)")
        return

    id_width = 36
    name_width = max(max(len(_truncate(c.get("name", ""), 20)) for c in items), 10)
    role_width = max(max(len(c.get("role_type", "") or "N/A") for c in items), 12)

    header = f"{'ID':<{id_width}}  {'名称':<{name_width}}  {'角色类型':<{role_width}}"
    sep = "─" * len(header)
    print(sep)
    print(header)
    print(sep)
    for c in items:
        cid = str(c.get("id", ""))
        name = _truncate(c.get("name", ""), name_width)
        role = c.get("role_type") or "N/A"
        print(f"{cid:<{id_width}}  {name:<{name_width}}  {role:<{role_width}}")
    print(sep)
    print(f"共 {len(items)} 个角色")


# ── subcommand: export ────────────────────────────────────────────────

def cmd_export(args):
    """导出项目为 JSON / TXT / MD 格式。"""
    fmt = args.format
    output_dir = args.output_dir or "./exports"
    os.makedirs(output_dir, exist_ok=True)

    # 先查项目名
    try:
        proj = _api_get(f"/projects/{args.project_id}")
    except SystemExit:
        print("(如果项目不存在，请先运行 novel list 查看可用项目)", file=sys.stderr)
        sys.exit(1)

    project_name = _safe_name(proj.get("name", ""))
    date_str = datetime.now().strftime("%Y-%m-%d")

    resp = _api_get_raw(f"/projects/{args.project_id}/export/safe?format={fmt}")
    body = resp.text

    filename = f"project-{project_name}-{date_str}.{fmt}"
    filepath = os.path.join(output_dir, filename)
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(body)

    file_size = os.path.getsize(filepath)
    print(f"✓ 已导出到: {filepath}")
    print(f"  格式: {fmt}  |  大小: {file_size:,} bytes")


# ── subcommand: backup ────────────────────────────────────────────────

def cmd_backup(args):
    """备份项目完整数据为 JSON 文件。"""
    resp = _api_get_raw(f"/projects/backup/{args.project_id}")
    body = resp.text

    # 从 Content-Disposition 解析文件名
    disposition = resp.headers.get("Content-Disposition", "")
    filename = None
    if "filename" in disposition:
        # Try filename*=UTF-8''...
        if "filename*=" in disposition:
            import re
            m = re.search(r"filename\*=(?:utf-8''|UTF-8'')([^;]+)", disposition, re.IGNORECASE)
            if m:
                from urllib.parse import unquote
                filename = unquote(m.group(1))
        if not filename:
            m = re.search(r'filename="?([^";]+)"?', disposition)
            if m:
                filename = m.group(1)

    if not filename:
        date_str = datetime.now().strftime("%Y-%m-%d")
        filename = f"backup-{date_str}.json"

    with open(filename, "w", encoding="utf-8") as f:
        f.write(body)

    file_size = os.path.getsize(filename)
    print(f"✓ 备份已保存到: {filename}")
    print(f"  大小: {file_size:,} bytes")


# ── subcommand: search ────────────────────────────────────────────────

def cmd_search(args):
    """搜索项目内容（全文检索）。"""
    result = _api_post(
        f"/projects/{args.project_id}/search",
        data={"query": args.keyword, "top_k": 5}
    )
    results = result.get("results", [])
    total = result.get("total", len(results))

    if not results:
        print(f"未找到匹配 \"{args.keyword}\" 的结果。")
        return

    source_labels = {
        "chapter": "章节",
        "character": "角色",
        "worldview": "世界观",
        "knowledge": "知识",
    }

    sep = "─" * 70
    for i, r in enumerate(results, 1):
        print(f"\n【结果 {i}】")
        src = r.get("source", "?")
        src_label = source_labels.get(src, src)
        meta = r.get("metadata", {})
        title = meta.get("title", "?")
        score = r.get("score", 0)
        content = r.get("content", "")

        print(f"  来源: {src_label} | 标题: {title} | 相关度: {score}")
        print(f"  {sep}")
        # 按行输出，截断过长内容
        for line in content.split("\n"):
            if len(line) > 120:
                line = line[:117] + "..."
            print(f"  {line}")
    print(f"\n共找到 {total} 条结果")


# ── main ───────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="novel",
        description="AI Novel Workstation CLI 工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
使用示例:
  novel create "我的小说"
  novel list projects
  novel list chapters --project-id <ID>
  novel list characters --project-id <ID>
  novel export <ID> --format=json --output-dir=./exports
  novel backup <ID>
  novel search <ID> "关键词"
""",
    )

    subparsers = parser.add_subparsers(dest="command", help="子命令")

    # ── create ──
    p_create = subparsers.add_parser("create", help="创建新项目")
    p_create.add_argument("name", help="项目名称")
    p_create.add_argument("--description", "-d", default="", help="项目描述")
    p_create.add_argument("--genre", "-g", default="other", help="流派 (默认: other)")
    p_create.set_defaults(func=cmd_create)

    # ── list ──
    p_list = subparsers.add_parser("list", help="列出项目/章节/角色")
    p_list.add_argument(
        "type", nargs="?", default="projects",
        choices=["projects", "chapters", "characters"],
        help="列出类型 (默认: projects)"
    )
    p_list.add_argument(
        "--project-id", "-p",
        help="项目 ID（列出 chapters/characters 时必需）"
    )
    p_list.set_defaults(func=cmd_list)

    # ── export ──
    p_export = subparsers.add_parser("export", help="导出项目")
    p_export.add_argument("project_id", help="项目 ID")
    p_export.add_argument(
        "--format", "-f", default="json",
        choices=["json", "txt", "md"],
        help="导出格式 (默认: json)"
    )
    p_export.add_argument(
        "--output-dir", "-o", default="./exports",
        help="输出目录 (默认: ./exports)"
    )
    p_export.set_defaults(func=cmd_export)

    # ── backup ──
    p_backup = subparsers.add_parser("backup", help="备份项目数据")
    p_backup.add_argument("project_id", help="项目 ID")
    p_backup.set_defaults(func=cmd_backup)

    # ── search ──
    p_search = subparsers.add_parser("search", help="搜索项目内容")
    p_search.add_argument("project_id", help="项目 ID")
    p_search.add_argument("keyword", help="搜索关键词")
    p_search.set_defaults(func=cmd_search)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()